{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4gatepylon/Warped/common/maps/map.schema.json",
  "title": "Warped map",
  "description": "A level's static layout; see common/maps/README.md for what each field means.",
  "type": "object",
  "required": ["format", "version", "name", "description", "source", "space", "gravity_m_per_s2", "player", "materials", "ground", "sky", "spawns", "appearance"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "warped-map"},
    "version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "description": {"type": "string"},
    "source": {"type": "string"},
    "space": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["hyperbolic", "spherical", "euclidean"]},
        "curvature_radius_m": {"type": "number", "exclusiveMinimum": 0}
      },
      "if": {"properties": {"kind": {"enum": ["hyperbolic", "spherical"]}}},
      "then": {"required": ["curvature_radius_m"]},
      "else": {"not": {"required": ["curvature_radius_m"]}}
    },
    "gravity_m_per_s2": {"type": "number", "minimum": 0},
    "player": {
      "type": "object",
      "required": ["eye_height_m", "walk_m_per_s", "sprint_m_per_s", "jump_m_per_s", "fly_m_per_s"],
      "additionalProperties": false,
      "properties": {
        "eye_height_m": {"type": "number", "exclusiveMinimum": 0},
        "walk_m_per_s": {"type": "number", "exclusiveMinimum": 0},
        "sprint_m_per_s": {"type": "number", "exclusiveMinimum": 0},
        "jump_m_per_s": {"type": "number", "minimum": 0},
        "fly_m_per_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "name", "color", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 0, "maximum": 255},
          "name": {"type": "string"},
          "color": {"$ref": "#/$defs/color"},
          "kind": {"enum": ["empty", "solid", "glass", "light"]}
        }
      }
    },
    "ground": {
      "type": "object",
      "required": ["material"],
      "additionalProperties": false,
      "properties": {
        "material": {"$ref": "#/$defs/material_id"},
        "tiling": {
          "type": "object",
          "required": ["kind", "cells_per_side"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "square_order_5"},
            "cells_per_side": {"type": "integer", "minimum": 1}
          }
        },
        "terrain": {
          "type": "object",
          "required": ["kind", "rim_u_m", "rim_v_m", "wall_m", "rim_height_m", "relief_m", "relief_wavelength_m", "seed"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "crater"},
            "rim_u_m": {"type": "number", "exclusiveMinimum": 0},
            "rim_v_m": {"type": "number", "exclusiveMinimum": 0},
            "wall_m": {"type": "number", "exclusiveMinimum": 0},
            "rim_height_m": {"type": "number", "minimum": 0},
            "relief_m": {"type": "number", "minimum": 0},
            "relief_wavelength_m": {"type": "number", "exclusiveMinimum": 0},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "mounds": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["u_m", "v_m", "radius_m", "height_m"],
                "additionalProperties": false,
                "properties": {
                  "u_m": {"type": "number"},
                  "v_m": {"type": "number"},
                  "radius_m": {"type": "number", "exclusiveMinimum": 0},
                  "height_m": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "frame", "shapes"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "frame": {"$ref": "#/$defs/frame"},
          "mesh": {
            "type": "object",
            "required": ["model", "height_m"],
            "additionalProperties": false,
            "properties": {
              "model": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "height_m": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "shapes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "centre_m", "half_m", "material"],
              "additionalProperties": false,
              "properties": {
                "kind": {"enum": ["box", "cylinder", "ellipsoid"]},
                "centre_m": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
                "half_m": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
                "round_m": {"type": "number", "minimum": 0},
                "axis": {"type": "integer", "minimum": 0, "maximum": 2},
                "material": {"$ref": "#/$defs/material_id"}
              }
            }
          }
        }
      }
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "group", "frame", "half_size_m", "material"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "group": {"type": "string"},
          "frame": {"$ref": "#/$defs/frame"},
          "half_size_m": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
          "material": {"$ref": "#/$defs/material_id"}
        }
      }
    },
    "warps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "frame", "law", "schwarzschild_radius_m", "radial_coordinate", "reach_m", "falloff"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["black_hole", "wormhole_mouth"]},
          "name": {"type": "string"},
          "frame": {"$ref": "#/$defs/frame"},
          "law": {"enum": ["isotropic_schwarzschild", "foil"]},
          "schwarzschild_radius_m": {"type": "number", "exclusiveMinimum": 0},
          "lambda_squared": {"type": "number", "minimum": 0},
          "radial_coordinate": {"enum": ["distance", "flat_effective"]},
          "reach_m": {"type": "number", "exclusiveMinimum": 0},
          "falloff": {"enum": ["taper", "cutoff"]},
          "partner": {"type": "integer", "minimum": 0}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "wormhole_mouth"}}}, "then": {"required": ["partner"], "properties": {"law": {"const": "foil"}}}},
          {"if": {"properties": {"kind": {"const": "black_hole"}}}, "then": {"not": {"required": ["partner"]}, "properties": {"law": {"const": "isotropic_schwarzschild"}}}},
          {"if": {"properties": {"law": {"const": "foil"}}}, "then": {"required": ["lambda_squared"]}}
        ]
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "color", "radius_m"],
        "additionalProperties": false,
        "properties": {
          "position": {"$ref": "#/$defs/vector4"},
          "color": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 3},
          "radius_m": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "sky": {
      "type": "object",
      "required": ["transport", "sun", "stars", "clouds", "zenith_color", "horizon_color"],
      "additionalProperties": false,
      "properties": {
        "transport": {"enum": ["parallel", "ideal"]},
        "sun": {
          "type": "object",
          "required": ["direction", "color"],
          "additionalProperties": false,
          "properties": {"direction": {"$ref": "#/$defs/vector3"}, "color": {"$ref": "#/$defs/color"}}
        },
        "planet": {
          "type": "object",
          "required": ["direction", "angular_radius_rad"],
          "additionalProperties": false,
          "properties": {
            "direction": {"$ref": "#/$defs/vector3"},
            "angular_radius_rad": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "milky_way": {
          "type": "object",
          "required": ["pole_direction", "core_direction"],
          "additionalProperties": false,
          "properties": {
            "pole_direction": {"$ref": "#/$defs/vector3"},
            "core_direction": {"$ref": "#/$defs/vector3"}
          }
        },
        "stars": {"type": "boolean"},
        "clouds": {"type": "boolean"},
        "zenith_color": {"$ref": "#/$defs/color"},
        "horizon_color": {"$ref": "#/$defs/color"},
        "fog_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["team", "frame"],
        "additionalProperties": false,
        "properties": {"team": {"enum": ["blue", "red", "any"]}, "frame": {"$ref": "#/$defs/frame"}}
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["team", "u_min_m", "u_max_m"],
            "additionalProperties": false,
            "properties": {
              "team": {"enum": ["blue", "red", "middle"]},
              "u_min_m": {"type": ["number", "null"]},
              "u_max_m": {"type": ["number", "null"]}
            }
          }
        },
        "boundary": {
          "type": "object",
          "required": ["kind", "u_m", "v_m"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "fermi_ellipse"},
            "u_m": {"type": "number", "exclusiveMinimum": 0},
            "v_m": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "zone_walls": {
          "type": "object",
          "required": ["height_m", "thickness_m", "opacity_frac"],
          "additionalProperties": false,
          "properties": {
            "height_m": {"type": "number", "exclusiveMinimum": 0},
            "thickness_m": {"type": "number", "exclusiveMinimum": 0},
            "opacity_frac": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
          }
        }
      }
    },
    "appearance": {
      "type": "object",
      "required": ["style", "lighting"],
      "additionalProperties": false,
      "properties": {
        "style": {"type": "string"},
        "laser_color": {"$ref": "#/$defs/color", "description": "One laser colour (display RGB, 0 to 1) for every team on this map; without it, each team fires its own colour."},
        "lighting": {
          "oneOf": [
            {
              "type": "object",
              "required": ["model", "ambient", "sun"],
              "additionalProperties": false,
              "properties": {"model": {"const": "ambient_sun"}, "ambient": {"type": "number"}, "sun": {"type": "number"}}
            },
            {
              "type": "object",
              "required": ["model", "lommel_seeliger_frac", "ambient", "earthshine", "sun_intensity", "shadows"],
              "additionalProperties": false,
              "properties": {
                "model": {"const": "lunar_lambert"},
                "lommel_seeliger_frac": {"type": "number", "minimum": 0, "maximum": 1},
                "ambient": {"type": "number"},
                "earthshine": {"type": "number"},
                "sun_intensity": {"type": "number"},
                "shadows": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fog": {
          "type": "object",
          "required": ["color", "start_m", "distance_m", "max_frac"],
          "additionalProperties": false,
          "properties": {
            "color": {"$ref": "#/$defs/color"},
            "start_m": {"type": "number", "minimum": 0},
            "distance_m": {"type": "number", "exclusiveMinimum": 0},
            "max_frac": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "sand": {
          "type": "object",
          "description": "How strong the fog's blowing sand is: gusts thickening the fog, streaks near the eye, sheets drifting downwind (each 0 to 1).",
          "required": ["gust_frac", "streak_frac", "sheet_frac"],
          "additionalProperties": false,
          "properties": {
            "gust_frac": {"type": "number", "minimum": 0, "maximum": 1},
            "streak_frac": {"type": "number", "minimum": 0, "maximum": 1},
            "sheet_frac": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "wind": {
          "type": "object",
          "required": ["direction", "log_index_gradient_per_m", "segment_m"],
          "additionalProperties": false,
          "properties": {
            "direction": {"$ref": "#/$defs/vector3"},
            "log_index_gradient_per_m": {"type": "number"},
            "segment_m": {"type": "number", "exclusiveMinimum": 0},
            "gust": {
              "type": "object",
              "description": "Gusts: the wind's strength (not its direction) times 1 plus up to strength_frac, from three waves size_m across seeded by seed, drifting downwind at speed_m_per_s, on the shared UTC clock.",
              "required": ["seed", "strength_frac", "size_m", "speed_m_per_s"],
              "additionalProperties": false,
              "properties": {
                "seed": {"type": "integer", "minimum": 0},
                "strength_frac": {"type": "number", "minimum": 0, "maximum": 1},
                "size_m": {"type": "number", "exclusiveMinimum": 0},
                "speed_m_per_s": {"type": "number"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3},
    "material_id": {"type": "integer", "minimum": 0, "maximum": 255},
    "vector3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "vector4": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "frame": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16}
  }
}
